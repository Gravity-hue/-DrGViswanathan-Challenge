class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
       int n=nums1.size();

       bool allOdd=true;
       bool allEven=true;

       for(int i=0; i<n; i++){//allEven case
        if(nums1[i]%2!=0){
            allEven=false;
            break;
        }
       }

        for(int i=0; i<n; i++){//allOdd case
        if(nums1[i]%2!=0){
            allOdd=false;
            break;
        }
       }

       if(allOdd || allEven)return true;

    //if both exist, than i will make all elements odd
       int minOdd=INT_MAX;

       for(int i=0; i<n; i++){
        if(nums1[i]%2!=0){
            minOdd=min(minOdd, nums1[i]);
        }
       }

       for(int i=0; i<n; i++){
        if(nums1[i]%2==0 && minOdd>nums1[i])return false;
       }

    return true;
    }
};
