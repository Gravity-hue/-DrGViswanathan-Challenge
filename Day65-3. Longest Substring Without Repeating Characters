class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int maxLength = 0;
        unordered_set<char> st;

        int i = 0;
        int j = 0;
        int n = s.size();

        while (j < n) {
    if (st.find(s[j]) == st.end()) {
        st.insert(s[j]);
        maxLength = max(maxLength, j - i + 1);
        j++;
    } else {
        st.erase(s[i]);
        i++;
    }
}

        return maxLength;
    }
};
