class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n=nums.size();
        if(n==0)return -1;

        vector<int>previousLargest(n);
        previousLargest[0]=nums[0];

        vector<int>nextSmallest(n);
        nextSmallest[n-1]=nums[n-1];

        for(int i=1; i<n; i++){
            previousLargest[i]=max(previousLargest[i-1], nums[i]);
            //nextSmallest
            nextSmallest[n-i-1]=min(nums[n-i-1], nextSmallest[n-i]);
        }

        for(int j=0; j<n; j++){
            if(previousLargest[j]-nextSmallest[j]<=k)return j;
        }

        return -1;
    }
    
};
