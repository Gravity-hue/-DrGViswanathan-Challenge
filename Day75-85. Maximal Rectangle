class Solution {
public:

int largestRectangleArea(vector<int> arr){//Histogram Rectangle logic
    int n=arr.size();
    int largestArea=0;
    stack<int>st;

    for(int i=0; i<n; i++){
        int localArea=0;

    while(!st.empty() && arr[st.top()]>=arr[i]){
        int nextSmaller=i;
        int el=arr[st.top()];
        st.pop();

        int prevSmaller=-1;
        if(!st.empty()){
            prevSmaller=st.top();
        }
        localArea=(nextSmaller-prevSmaller-1)*el;
        largestArea=max(largestArea,localArea);
    }
    st.push(i);
    }

    while(!st.empty()){
        int nextSmaller=n;
        int el=arr[st.top()];
        st.pop();
        int prevSmaller=-1;

        if(!st.empty()){
            prevSmaller=st.top();
        }
        int localArea=(nextSmaller-prevSmaller-1)*el;
        largestArea=max(largestArea,localArea);
    }
    return largestArea;
}


    int maximalRectangle(vector<vector<char>>& matrix) {
        if(matrix.empty()) return 0;
        int row=matrix.size();
        int col=matrix[0].size();
        int maxRectangleArea=0;
        vector<int> heights(col, 0);

        for(int i = 0; i < row; i++){
            for(int j = 0; j < col; j++){
                if(matrix[i][j] == '1')
                    heights[j]++;
                else
                    heights[j] = 0;}
                    
            maxRectangleArea = max(maxRectangleArea, largestRectangleArea(heights));
        }
        return maxRectangleArea;
    
}
}
;
