class MyCircularDeque {
public:
    int st=-1;
    int end=-1;
    int currSize=0;
    vector<int> arr;
    int sz;

    MyCircularDeque(int k) {
        sz=k;
        arr.resize(k);
    }
    
    bool insertFront(int value) {
        if(currSize==sz)return false;
        if(currSize==0){
            st=end=0;
        }else{
        st=(st+sz-1)%sz;}
        arr[st]=value;
        currSize++;
        return true;
    }
    
    bool insertLast(int value) {
        if(currSize==sz)return false;
        if(currSize==0){
            st=end=0;
        }else{
        end=(end+1)%sz;}
        arr[end]=value;
        currSize++;
        return true;
    }
    
    bool deleteFront() {
        if(currSize==0)return false;
        if(currSize==1){
            st=end=-1;
        }else{
            st=(st+1)%sz;
        }
        currSize--;
        return true;
    }
    
    bool deleteLast() {
        if(currSize==0)return false;
        if(currSize==1){
            st=end=-1;
        }else{
            end=(end+sz-1)%sz;
        }
        currSize--;
        return true;
    }
    
    int getFront() {
        if(currSize==0)return -1;
        return arr[st];
    }
    
    int getRear() {
        if(currSize==0)return -1;
        return arr[end];
    }
    
    bool isEmpty() {
        return (currSize==0);
    }
    
    bool isFull() {
        return (currSize==sz);
    }
};

