class Solution {
public:
    int singleNonDuplicate(vector<int>& nums) {
        if(nums.size()==1){
                return nums[0];
            }

        int st=0;
        int end=nums.size()-1;

        while(st<=end){
            int mid=st+(end-st)/2;

            //special cases
            //corner case1
            if(mid==0 && nums[0]!=nums[1]) return nums[mid];
            //corner case2
            if(mid==nums.size()-1 && nums[mid]!=nums[mid-1])return nums[mid];
    
            if(nums[mid]!=nums[mid-1] && nums[mid]!=nums[mid+1])return nums[mid];

            else if(mid%2==0){//even no. of elements in left and right
                if(nums[mid-1]==nums[mid]){
                    end=mid-1;//odd left case
                }else{
                    st=mid+1;//right case
                }
            }else{//even no. of elements in left and right
                if(nums[mid-1]==nums[mid]){
                    st=mid+1;
                }else{
                    end=mid-1;
                }
            }
        }
        return -1;        
    }
};
