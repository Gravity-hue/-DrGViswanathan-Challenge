class Solution {
public:
    int findDuplicate(vector<int>& nums) {//using slow fast approach
        //assumed array to be linked list
        int slow=nums[0];
        int fast=nums[0];

        do{
        //as at starting they are pointing to the same
        slow=nums[slow];//slow=slow+1
        fast=nums[nums[fast]];//fast=fast+2
        }while(slow!=fast);

        slow=nums[0];//re-initailse

        while(slow!=fast){
        slow=nums[slow];//slow=slow+1
        fast=nums[fast];//fast=fast+1
        }

        return slow;
        
    }
};
