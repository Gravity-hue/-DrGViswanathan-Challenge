class Solution {
public:

    int underLimitSubarrays(vector<int>& arr, int target){//calculates total Subarrays whose sum<=target
        if(target<0)return 0;

        int n=arr.size();
        int left=0, right=0, sum=0, totalSubs=0;

        while(right<n){
            sum+=arr[right];

            while(sum>target){
                sum-=arr[left];
                left++;
            }
            totalSubs+=right-left+1;
            right++;
        }
        return totalSubs;
    }

    int numSubarraysWithSum(vector<int>& nums, int goal) {
        int lessEqalsGoal=underLimitSubarrays(nums, goal);//subarrays whose sum<=goal
        int strictlyLess=underLimitSubarrays(nums, goal-1);//subarrays whose sum<=goal-1

        return lessEqalsGoal-strictlyLess;
    }
};
