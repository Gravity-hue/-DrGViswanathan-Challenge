class Solution {
public:
    int numberOfSubstrings(string s) {
        int n = s.length();
        int left = 0;
        int total = 0;

        map<char, int> mp;

        for(int right = 0; right < n; right++) {

            mp[s[right]]++;

            while(mp.size() == 3) {
                total += n - right;

                mp[s[left]]--;

                if(mp[s[left]] == 0) {
                    mp.erase(s[left]);
                }

                left++;
            }
        }

        return total;
    }
};

