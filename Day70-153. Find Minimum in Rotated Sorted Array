class Solution {
public:
    int findMin(vector<int>& nums) {
        int low=0;
        int high=nums.size()-1;
        int mini=INT16_MAX;

        while(low<=high){
            int mid=low+(high-low)/2;

            if(nums[mid]<=nums[high]){//right sorted
                mini=min(mini,nums[mid]);
                high=mid-1;}

            if(nums[low]<=nums[mid]){//left sorted
                mini=min(mini,nums[low]);
                low=mid+1;}
        }
        return mini;
    }
};
