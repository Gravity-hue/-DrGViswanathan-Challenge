class MyCircularQueue {
public:
    int st=-1;
    int end=-1;
    int currSize=0;
    int size;
    vector<int>arr;

    MyCircularQueue(int k) {
        size=k;
        arr.resize(k);
    }
    
    bool enQueue(int value) {
        if(currSize==size)return false;
        if(currSize==0){
            st=end=0;
        }
        else{
            end=(end+1)%size;
        }
        arr[end]=value;
        currSize++;
        return true;
    }
    
    bool deQueue() {
        if(currSize==0)return false;
        if(currSize==1){
            st=end=-1;
        }
        else{
            st=(st+1)%size;
        }
        currSize--;
        return true;
    }
    
    int Front() {
        if(currSize==0)return -1;
        return arr[st];
    }
    
    int Rear() {
        if(currSize==0)return -1;
        return arr[end];
    }
    
    bool isEmpty() {
        if(currSize==0)return true;
        return false;
    }
    
    bool isFull() {
        if(currSize==size)return true;
        return false;
    }
};

