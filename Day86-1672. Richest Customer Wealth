class Solution {
public:
    int maximumWealth(vector<vector<int>>& accounts) {
        int maxWealth=0;
        int row=accounts.size();
        int col=accounts[0].size();

        for(int r=0; r<row; r++){
            int localSum=0;
            for(int c=0; c<col; c++){
                localSum+=accounts[r][c];
            }
            maxWealth=max(maxWealth, localSum);
        }
        return maxWealth;
    }
};
