class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {//Return the lower bound
        int ans=nums.size();
        int low=0;
        int high=nums.size()-1;

        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[mid]>=target){
                ans=min(ans,mid);
                high=mid-1;//in left side min idx is possible satisfying the condition
            }else{
                low=mid+1;
            }
        }
        return ans;
    }
};
