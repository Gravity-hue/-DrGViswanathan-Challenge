class MinStack {
public:
    stack <int>stMain, stMin;

    MinStack() {
        
    }
    
    void push(int value) {
        stMain.push(value);
        if(stMin.empty()){
            stMin.push(value);
        }
        else{
            if(value<=stMin.top()){
                stMin.push(value);
            }
        }
    }
    
    void pop() {
        if(stMain.top()==stMin.top()){
            stMin.pop();
        }
        stMain.pop();
    }
    
    int top() {
        if(stMain.empty())return -1;
        return stMain.top();
    }
    
    int getMin() {
        return stMin.top();
    }
};

