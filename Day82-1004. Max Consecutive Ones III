class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int n=nums.size();
        int longest=0;

        int left=0;
        int right=0;
        int atmostZeroes=0;

        while(right<n){
            
            if(nums[right]==0)atmostZeroes++;

            while(atmostZeroes>k){
                if(nums[left]==0)atmostZeroes--;
                left++;
            }

            longest=max(right-left+1, longest);
            right++;
        }
        
        return longest;
    }
};
