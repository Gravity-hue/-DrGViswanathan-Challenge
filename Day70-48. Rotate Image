class Solution {
public:
    void rotate(vector<vector<int>>& matrix) {
        int n=matrix.size();//as n*n matrix
        vector<vector<int>> ans(n, vector<int>(n));//defined the size of ans matrix

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){
                int value=matrix[i][j];
                ans[j][n-i-1]=value;
            }
        }

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){//Copying in original matrix
                matrix[i][j]=ans[i][j];
            }
        }
    }
};
